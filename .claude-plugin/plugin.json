{
  "name": "claude-rescue",
  "version": "0.1.0",
  "description": "Hot-swap models mid-task inside Claude Code. Dispatch to any Anthropic-compatible backend (DeepSeek, GLM, Qwen, Kimi, ...) per call, without touching your main-thread subscription.",
  "author": {
    "name": "suharvest",
    "email": "suharvest@gmail.com",
    "url": "https://github.com/suharvest"
  },
  "repository": "https://github.com/suharvest/claude-rescue",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "anthropic",
    "subagent",
    "multi-model",
    "deepseek",
    "glm",
    "qwen",
    "plugin"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-lifecycle-hook.mjs\" SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-lifecycle-hook.mjs\" SessionEnd",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stop-review-gate-hook.mjs\"",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/post-tool-use-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}